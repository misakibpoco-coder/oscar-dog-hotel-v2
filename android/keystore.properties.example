# Copy to android/keystore.properties (git-ignored) and fill in.
# Create the keystore once with:
#   keytool -genkeypair -v -keystore oscar-v2-release.jks -alias oscar-v2 -keyalg RSA -keysize 2048 -validity 10000
# Keep 2 backups of the .jks file AND these passwords. Losing them = you can never update the app again.
storeFile=../oscar-v2-release.jks
storePassword=
keyAlias=oscar-v2
keyPassword=
