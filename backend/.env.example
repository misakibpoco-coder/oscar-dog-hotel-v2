# Oscar Dog Hotel V2 — backend environment (copy to backend/.env, never commit)
PORT=4000
NODE_ENV=development
HOTEL_TIMEZONE=Europe/Nicosia
CORS_ORIGIN=*

# NEW V2 database only. The app refuses to start if this points at the V1 project.
DATABASE_URL=postgresql://postgres:postgres@localhost:5434/oscar_dog_hotel_v2

# Generate each with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=CHANGE_ME
JWT_REFRESH_SECRET=CHANGE_ME
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# Google Drive Backups (optional)
GOOGLE_DRIVE_CLIENT_EMAIL=
GOOGLE_DRIVE_PRIVATE_KEY=
GOOGLE_DRIVE_FOLDER_ID=
BACKUP_RETENTION_DAYS=14
BACKUP_ENCRYPTION_KEY=CHANGE_ME
